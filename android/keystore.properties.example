# Copy to android/keystore.properties and fill in. Gitignored — never commit
# the real file or the .jks itself.
#
# Create an upload keystore once:
#   keytool -genkeypair -v -keystore ~/keys/beer-counter-upload.jks \
#     -keyalg RSA -keysize 4096 -validity 10000 -alias upload
storeFile=/home/you/keys/beer-counter-upload.jks
storePassword=changeme
keyAlias=upload
keyPassword=changeme

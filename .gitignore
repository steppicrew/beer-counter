node_modules/
dist/
dist-ssv/
.env
*.local
*.log

# Yarn 4 PnP: keep releases/plugins, ignore the caches and unplugged state.
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnp.*

# Android build output
android/.gradle/
android/build/
android/app/build/
android/app/release/
android/local.properties
android/.idea/
*.keystore
!debug.keystore
keystore.properties

# Generated assets (rebuilt by `yarn assets` / `yarn screenshots`)
public/icons/
public/favicon.svg
assets/play/
assets/screenshots/*/

# Exported per-language listing files (regenerated by `yarn store-listing`)
store-listing/*/
build-output/

# Launcher icons + localised labels are generated by `yarn assets`
android/app/src/main/res/mipmap-*/
android/app/src/main/res/values-*/strings.xml
android/app/src/main/res/values/ic_launcher_background.xml

# TypeScript incremental build info
*.tsbuildinfo

# Privacy pages are generated by `yarn privacy`
public/privacy/
public/impressum/

# Google Play service-account keys — never commit these
play-service-account.json
*-service-account.json
*.serviceaccount.json
Screenshot.png

# Editor lock files
.#*
